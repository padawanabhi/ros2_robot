<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_robot_description</name>
  <version>0.0.0</version>
  <description>URDF/Xacro model for my_robot, including sensors and Gazebo plugins.</description>
  <maintainer email="dev@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <build_depend>joint_state_publisher</build_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <build_depend>joint_state_publisher_gui</build_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <depend>gazebo_ros</depend>
  <depend>launch_ros</depend>
  <depend>urdf</depend>
  <depend>controller_manager</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
